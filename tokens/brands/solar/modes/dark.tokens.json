{
  "$extensions": {
    "com.orrery": {
      "mode": {
        "id": "dark",
        "name": "Dark"
      }
    }
  },
  "color": {
    "$type": "color",
    "page": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0235,
          0.0275,
          0.0471
        ],
        "hex": "#06070c"
      }
    },
    "layer-1": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0392,
          0.0471,
          0.0784
        ],
        "alpha": 0.82
      }
    },
    "layer-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1216,
          0.1216,
          0.1294
        ],
        "hex": "#1f1f21"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2,
          1,
          0.9412
        ],
        "alpha": 0.28
      }
    },
    "line-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2,
          1,
          0.9412
        ],
        "alpha": 0.45
      }
    },
    "line-dashed": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4314,
          0.4314,
          0.451
        ],
        "hex": "#6e6e73"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9333,
          0.9451,
          0.9686
        ],
        "hex": "#eef1f7"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9333,
          0.9451,
          0.9686
        ],
        "alpha": 0.62
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2,
          1,
          0.9412
        ],
        "hex": "#33fff0"
      }
    },
    "on-accent": {
      "$value": "{color.page}"
    },
    "scale-1": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1725,
          0.1725,
          0.1804
        ],
        "hex": "#2c2c2e"
      }
    },
    "scale-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2824,
          0.2824,
          0.2902
        ],
        "hex": "#48484a"
      }
    },
    "scale-3": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5569,
          0.5569,
          0.5765
        ],
        "hex": "#8e8e93"
      }
    },
    "scale-4": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.7804,
          0.7804,
          0.8
        ],
        "hex": "#c7c7cc"
      }
    },
    "scale-5": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9686
        ],
        "hex": "#f5f5f7"
      }
    },
    "scale-1-ink": {
      "$value": "{color.text}"
    },
    "scale-2-ink": {
      "$value": "{color.text}"
    },
    "scale-3-ink": {
      "$value": "{color.page}"
    },
    "scale-4-ink": {
      "$value": "{color.page}"
    },
    "scale-5-ink": {
      "$value": "{color.page}"
    }
  },
  "shadow": {
    "shadow-lift": {
      "$value": []
    }
  }
}
