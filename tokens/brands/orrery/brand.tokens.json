{
  "$description": "Brand orrery: the default Orrery look. Monochrome; accent equals text.",
  "$extensions": {
    "com.orrery": {
      "name": "orrery",
      "modes": [
        "light",
        "dark"
      ],
      "unlocked": [
        "*"
      ],
      "optOut": [
        {
          "check": "contrast",
          "role": "color.line-dashed",
          "surface": "color.page",
          "mode": "light",
          "reason": "pre-existing, pending Sean's review"
        },
        {
          "check": "contrast",
          "role": "color.line-dashed",
          "surface": "color.layer-1",
          "mode": "light",
          "reason": "pre-existing, pending Sean's review"
        }
      ]
    }
  },
  "font": {
    "$type": "fontFamily",
    "$extensions": {
      "com.orrery": {
        "fonts": []
      }
    },
    "sans": {
      "$value": [
        "system-ui",
        "-apple-system",
        "SF Pro Text",
        "SF Pro Display",
        "Helvetica Neue",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "ui-monospace",
        "SF Mono",
        "Menlo",
        "monospace"
      ]
    }
  }
}
