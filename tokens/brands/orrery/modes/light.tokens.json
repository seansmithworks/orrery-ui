{
  "$extensions": {
    "com.orrery": {
      "mode": {
        "id": "light",
        "name": "Light"
      }
    }
  },
  "color": {
    "$type": "color",
    "page": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "layer-1": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9686,
          0.9686,
          0.9725
        ],
        "hex": "#f7f7f8"
      }
    },
    "layer-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9373,
          0.9373,
          0.9451
        ],
        "hex": "#efeff1"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.08
      }
    },
    "line-strong": {
      "$value": "{color.text}"
    },
    "line-dashed": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6314,
          0.6314,
          0.651
        ],
        "hex": "#a1a1a6"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1137,
          0.1137,
          0.1216
        ],
        "hex": "#1d1d1f"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4314,
          0.4314,
          0.451
        ],
        "hex": "#6e6e73"
      }
    },
    "accent": {
      "$value": "{color.text}"
    },
    "on-accent": {
      "$value": "{color.page}"
    },
    "scale-1": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.898,
          0.898,
          0.9176
        ],
        "hex": "#e5e5ea"
      }
    },
    "scale-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.7804,
          0.7804,
          0.8
        ],
        "hex": "#c7c7cc"
      }
    },
    "scale-3": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5569,
          0.5569,
          0.5765
        ],
        "hex": "#8e8e93"
      }
    },
    "scale-4": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2824,
          0.2824,
          0.2902
        ],
        "hex": "#48484a"
      }
    },
    "scale-5": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1137,
          0.1137,
          0.1216
        ],
        "hex": "#1d1d1f"
      }
    },
    "scale-1-ink": {
      "$value": "{color.text}"
    },
    "scale-2-ink": {
      "$value": "{color.text}"
    },
    "scale-3-ink": {
      "$value": "{color.text}"
    },
    "scale-4-ink": {
      "$value": "{color.page}"
    },
    "scale-5-ink": {
      "$value": "{color.page}"
    }
  }
}
