{
  "name": "@orrery-ui/iris",
  "version": "0.1.1",
  "type": "module",
  "description": "Draggable trigger that morphs into a modal sheet. Generic React primitive, compound-component API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seansmithworks/orrery-ui.git"
  },
  "homepage": "https://github.com/seansmithworks/orrery-ui#readme",
  "bugs": {
    "url": "https://github.com/seansmithworks/orrery-ui/issues"
  },
  "keywords": [
    "react",
    "sheet",
    "modal",
    "trigger",
    "fab",
    "motion",
    "framer-motion",
    "dialog",
    "morph"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "orrery-iris": "./bin/orrery-iris.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-d.*",
    "bin",
    "tuner",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "motion": "^12.0.0 || ^13.0.0 || ^14.0.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.0",
    "@terrazzo/parser": "^2.10.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@ui-sdk/core": "0.1.0-beta.7",
    "@ui-sdk/react": "0.1.0-beta.7",
    "@vitejs/plugin-react": "^4.3.4",
    "dialkit": "^2.0.2",
    "jsdom": "^30.1.1",
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "dev": "vite example",
    "build:example": "vite build example",
    "build:lib": "vite build -c vite.lib.config.ts",
    "prepare": "npm run build:lib",
    "typecheck": "tsc -p tsconfig.types.json",
    "test": "vitest run",
    "test:geometry": "playwright test -c example/playwright.config.ts",
    "test:roles": "playwright test -c example/playwright.config.ts role-fallbacks --project=chromium",
    "test:kit-baseline": "playwright test -c example/playwright.config.ts kit-baseline --project=chromium --workers=1",
    "test:bridge": "playwright test -c example/playwright.config.ts role-bridge --project=chromium",
    "test:browsers": "ORRERY_BROWSERS=all playwright test -c example/playwright.config.ts",
    "audit:vars": "node scripts/audit-css-vars.mjs",
    "perf": "node scripts/perf-morph.mjs",
    "assert:client-banner": "node -e \"if (require('fs').readFileSync('dist/index.js','utf8').split('\\n')[0] !== '\\\"use client\\\";') { console.error('dist/index.js is missing the \\\"use client\\\" banner on line 1'); process.exit(1); }\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run audit:vars && npm run build:lib && npm run assert:client-banner && npm run test:geometry",
    "capture:canvas": "vite-node scripts/capture-canvas.ts",
    "tokens:build": "node tokens/build.mjs",
    "tokens:check": "node tokens/check.mjs",
    "rules:check": "node tokens/rules/check-source.mjs",
    "catalog:build": "node kit/catalog/build.mjs",
    "catalog:check": "node kit/catalog/check.mjs",
    "kit-preview:build": "node example/build-kit-preview.mjs",
    "kit-preview:check": "node example/build-kit-preview.mjs --check",
    "eval": "node eval/run.mjs",
    "eval:score": "node eval/score.mjs",
    "eval:report": "node eval/report.mjs",
    "eval:selftest": "node eval/selftest.mjs",
    "eval:lane2": "node eval/lane2/run.mjs",
    "eval:lane2:score": "node eval/lane2/score.mjs",
    "eval:lane2:report": "node eval/lane2/report.mjs"
  }
}
